# =============================================================================
# GlobalPay - example environment configuration
# =============================================================================
# Copy this file to `.env` and replace every placeholder (PASSWORD, YOUR_...).
#
# Why `.env`: the Next.js app reads both `.env` and `.env.local`, but the Prisma
# CLI (migrate/seed) and `npm test` read only `.env`. Keeping all values in `.env`
# avoids the two disagreeing. If you also create `.env.local`, its values
# override `.env` for the Next.js app only.
#
# Real `.env*` files are ignored by Git (see .gitignore). Never commit them.
# NODE_ENV is set automatically by Next.js and does not need to be defined here.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required) - MySQL 8.0+
# -----------------------------------------------------------------------------
# Illustrative values only: user `globalpay_app`, password `PASSWORD`, local host.
# SHADOW_DATABASE_URL is a separate, empty database used by Prisma during
# `prisma migrate dev`; the schema references it, so define it as well.
DATABASE_URL="mysql://globalpay_app:PASSWORD@127.0.0.1:3306/globalpay_dev"
SHADOW_DATABASE_URL="mysql://globalpay_app:PASSWORD@127.0.0.1:3306/globalpay_shadow"

# -----------------------------------------------------------------------------
# App origin (recommended)
# -----------------------------------------------------------------------------
# The base for the default PayPal return/cancel URLs, and an additional allowed
# origin for same-origin (CSRF) checks on state-changing API requests. Set it to
# the URL you open in the browser. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Anonymous demo session cookie (optional - defaults shown)
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME="gp_session"
SESSION_MAX_AGE_SECONDS="86400"

# -----------------------------------------------------------------------------
# PayPal Sandbox (required for checkout)
# -----------------------------------------------------------------------------
# From developer.paypal.com > Apps & Credentials (Sandbox) > your REST app.
# The client ID may alternatively be provided as PAYPAL_CLIENT_ID; it is only
# read on the server. The secret is server-only and must never be exposed.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
# Email of the Sandbox *business* (merchant) account linked to the app above.
# Captures are only accepted when PayPal reports this account as the payee.
PAYPAL_PAYEE_EMAIL="YOUR_SANDBOX_BUSINESS_ACCOUNT_EMAIL@example.com"
# Optional - defaults shown. Approval links are only accepted from PayPal Sandbox.
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_RETURN_URL="http://localhost:3000/pay/return"
PAYPAL_CANCEL_URL="http://localhost:3000/pay/cancel"

# -----------------------------------------------------------------------------
# Gemini travel payment assistant (optional)
# -----------------------------------------------------------------------------
# Leave AI_API_KEY empty to run without the assistant; the rest of the app works
# and the assistant page reports that chat is not configured.
# Get a key from Google AI Studio. AI_MODEL must be a model available to that key.
AI_PROVIDER="gemini"
AI_API_KEY="YOUR_GEMINI_API_KEY"
AI_MODEL="gemini-3.5-flash"

# -----------------------------------------------------------------------------
# Foreign exchange rates (optional - defaults shown)
# -----------------------------------------------------------------------------
# Indicative European Central Bank reference rates via Frankfurter; no key needed.
# Frankfurter is currently the only implemented provider. FX_PROVIDER and
# FX_API_KEY are read by the configuration but not used by Frankfurter.
FX_PROVIDER="frankfurter"
FX_API_KEY=""
FX_BASE_URL="https://api.frankfurter.app"
FX_CACHE_TTL_SECONDS="300"
