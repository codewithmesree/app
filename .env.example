# =============================================================================
# GlobalPay — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.
# .env* files are excluded from version control by .gitignore.
#
# See docs/setup-and-environment.md for setup instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL via Prisma)
# -----------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Use a dedicated least-privilege application account.
# Never use a root or admin account.
DATABASE_URL="mysql://globalpay_app:REPLACE_PASSWORD@localhost:3306/globalpay_dev"

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 bytes (64 hex chars) of cryptographic randomness.
# Change this value between environments; never reuse across dev/prod.
SESSION_SECRET="REPLACE_WITH_64_HEX_CHARS_OF_RANDOM_ENTROPY"
SESSION_COOKIE_NAME="gp_session"
# Session max age in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE_SECONDS="86400"

# -----------------------------------------------------------------------------
# PayPal Sandbox
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is the ONLY PayPal credential that belongs in
# NEXT_PUBLIC_* — the PayPal JS SDK requires it on the client side.
# PAYPAL_CLIENT_SECRET must NEVER be NEXT_PUBLIC_*.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="REPLACE_WITH_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="REPLACE_WITH_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# URLs PayPal redirects to after buyer approval/cancellation
PAYPAL_RETURN_URL="http://localhost:3000/pay/return"
PAYPAL_CANCEL_URL="http://localhost:3000/pay/cancel"

# -----------------------------------------------------------------------------
# AI Provider
# -----------------------------------------------------------------------------
# Supported: "gemini" | "openai"
AI_PROVIDER="gemini"
AI_API_KEY="REPLACE_WITH_AI_PROVIDER_API_KEY"
AI_MODEL="gemini-2.0-flash"

# -----------------------------------------------------------------------------
# Currency Rate Provider
# -----------------------------------------------------------------------------
# Supported: "frankfurter" (free, no key required) | "open-exchange-rates"
FX_PROVIDER="frankfurter"
# Leave blank for providers that do not require a key (e.g. frankfurter)
FX_API_KEY=""
FX_BASE_URL="https://api.frankfurter.app"
# How long to cache a rate before fetching fresh data (seconds)
FX_CACHE_TTL_SECONDS="300"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" to show sandbox labels in the UI
NEXT_PUBLIC_SANDBOX_MODE="true"

# -----------------------------------------------------------------------------
# Rate Limiting (optional — Upstash Redis for multi-instance deployments)
# Leave blank to use the in-memory fallback suitable for single-instance demos.
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

