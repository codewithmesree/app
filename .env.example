# GlobalPay local development environment
# Copy to .env.local and replace placeholders. Never commit real credentials.
# .env.local is ignored by Git. See README.md for setup details.

# MySQL databases and least-privilege application user
DATABASE_URL="mysql://globalpay_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/globalpay_dev"
SHADOW_DATABASE_URL="mysql://globalpay_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/globalpay_shadow"

# Anonymous demo session cookie (optional defaults shown)
SESSION_COOKIE_NAME="gp_session"
SESSION_MAX_AGE_SECONDS="86400"

# PayPal Sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID="REPLACE_WITH_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="REPLACE_WITH_SANDBOX_CLIENT_SECRET"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_PAYEE_EMAIL="sandbox-payee@example.test"
PAYPAL_RETURN_URL="http://localhost:3000/pay/return"
PAYPAL_CANCEL_URL="http://localhost:3000/pay/cancel"

# Frankfurter / European Central Bank indicative reference rates
FX_BASE_URL="https://api.frankfurter.app"
FX_CACHE_TTL_SECONDS="300"

# Used for same-origin request validation and PayPal return URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
